# Storage adapter: 'cloud-with-fallback' (default), 'yandex-cloud', 'local'
STORE_ADAPTER=cloud-with-fallback

# Local adapter — path to output directory (relative to cwd)
OUTPUT_DIR=./output

# Shared layer path override (leave empty to use default relative path)
# Set to /opt in Yandex Cloud (layer mount point)
SHARED_LAYER_PATH=

# --- AI APIs ---

# OpenAI — used by step-texts (GPT-4o-mini) and step-images (gpt-image-1)
OPENAI_API_KEY=

# Anthropic — used by step-images critic (Claude Vision)
ANTHROPIC_API_KEY=

# Kling.ai — used by step-video (image-to-video generation)
KLING_API_KEY=

# --- Yandex Message Queue (async step chaining) ---

YMQ_TEXTS_QUEUE_URL=
YMQ_IMAGES_QUEUE_URL=
YMQ_VIDEO_QUEUE_URL=

# --- Yandex Cloud Object Storage (artifacts) ---

YC_BUCKET_NAME=mold-pipeline-output
YC_ENDPOINT=https://storage.yandexcloud.net
# Service account static key (for Object Storage and YMQ)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Yandex Database (manifests) ---
# Document API endpoint — found in YDB console under "Document API endpoint"
YDB_DOCUMENT_API_ENDPOINT=
YDB_TABLE_NAME=mold-manifests
