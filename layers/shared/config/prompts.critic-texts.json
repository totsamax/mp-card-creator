{
  "rules": [
    {
      "field": "titleShort",
      "maxLength": 30,
      "message": "titleShort превышает 30 символов"
    },
    {
      "field": "titleFull",
      "maxLength": 200,
      "message": "titleFull превышает 200 символов"
    },
    {
      "field": "annotation",
      "maxLength": 200,
      "message": "annotation превышает 200 символов"
    }
  ],
  "requiredSubstrings": {
    "titleShort": [],
    "titleFull":  ["молд", "силиконовый"],
    "annotation": []
  },
  "bannedPhrases": ["бесплатная доставка", "лучший", "100%"],
  "topicKeywordCheck": {
    "enabled": true,
    "field": "titleFull",
    "message": "titleFull не содержит ключевых слов из темы товара"
  },
  "noUnresolvedPlaceholders": {
    "enabled": true,
    "field": "annotation",
    "pattern": "\\{\\{[^}]+\\}\\}",
    "message": "annotation содержит нераскрытый плейсхолдер"
  }
}
