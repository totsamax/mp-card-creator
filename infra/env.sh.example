#!/usr/bin/env bash
# Скопируй этот файл в infra/env.sh и заполни значения.
# infra/env.sh добавлен в .gitignore — не коммить его с реальными ключами.
#
# Запуск деплоя: source infra/env.sh && bash infra/deploy.sh

# ---------------------------------------------------------------------------
# Yandex Cloud
# ---------------------------------------------------------------------------
export YC_FOLDER_ID=            # yc config get folder-id
export YC_SERVICE_ACCOUNT_ID=   # ID сервисного аккаунта (SA)

# Статический ключ SA — используется для Object Storage, YMQ, YDB Document API.
# Создать: yc iam access-key create --service-account-id $YC_SERVICE_ACCOUNT_ID
export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# AI API-ключи (передаются в функции как env vars)
# ---------------------------------------------------------------------------
export OPENAI_API_KEY=
export ANTHROPIC_API_KEY=
export KLING_API_KEY=

# ---------------------------------------------------------------------------
# Имена облачных ресурсов (менять необязательно)
# ---------------------------------------------------------------------------
export YDB_DATABASE_NAME=mold-db
export YDB_TABLE_NAME=mold-manifests

export S3_BUCKET_NAME=mold-pipeline-output    # артефакты
export FRONTEND_BUCKET=mp-card-frontend        # фронтенд (static hosting)

export YMQ_TEXTS_QUEUE=mold-texts
export YMQ_IMAGES_QUEUE=mold-images
export YMQ_VIDEO_QUEUE=mold-video

export FUNCTIONS_PREFIX=mp        # функции: mp-api, mp-step-normalize, ...
export LAYER_NAME=mp-shared
export API_GATEWAY_NAME=mp-gateway

# ---------------------------------------------------------------------------
# Роли сервисного аккаунта — проверь до деплоя:
#   serverless.functions.invoker  (для YMQ-триггеров)
#   ymq.reader                    (читать из очереди)
#   storage.uploader              (писать артефакты)
#   ydb.viewer + ydb.editor       (работа с YDB)
# ---------------------------------------------------------------------------
