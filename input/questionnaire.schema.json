{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MoldQuestionnaire",
  "description": "Опросник для создания линейки молдов — вход пайплайна step-normalize",
  "type": "object",
  "required": ["moldName", "article", "brand", "theme", "color", "priceBaseM", "sizes", "moldType", "photos", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "moldName": {
      "type": "string",
      "minLength": 1,
      "description": "Имя молда, например «Василиса»"
    },
    "article": {
      "type": "string",
      "minLength": 1,
      "description": "Артикульная серия, например «0553»"
    },
    "brand": {
      "type": "string",
      "minLength": 1,
      "description": "Бренд"
    },
    "theme": {
      "type": "string",
      "minLength": 1,
      "description": "Тема / персонаж — для генерации текстов и изображений"
    },
    "color": {
      "type": "string",
      "minLength": 1,
      "description": "Цвет силикона"
    },
    "moldType": {
      "type": "string",
      "enum": ["face", "hands", "shoes", "other"],
      "description": "Тип молда — определяет шаблонные тексты и топик"
    },
    "priceBaseM": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Базовая цена за размер M, ₽"
    },
    "sizes": {
      "type": "array",
      "description": "Физические параметры для каждого из 5 размеров (XS→XL)",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["size", "moldSize", "moldLength", "moldWidth", "moldHeight", "moldWeight"],
        "additionalProperties": false,
        "properties": {
          "size": {
            "type": "string",
            "enum": ["XS", "S", "M", "L", "XL"]
          },
          "moldSize": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Характерный размер молда, см"
          },
          "moldLength": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Длина молда, см"
          },
          "moldWidth": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Ширина молда, см"
          },
          "moldHeight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Высота молда, см"
          },
          "moldWeight": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "Вес молда, г"
          }
        }
      }
    },
    "photos": {
      "type": "array",
      "description": "URL фотографий молда в Object Storage (≥1, разные ракурсы)",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Какие артефакты собирать",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["images", "video", "excel-ozon", "excel-wb"]
      },
      "uniqueItems": true
    }
  }
}
